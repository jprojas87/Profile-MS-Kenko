# Copia este archivo a .env y ajusta los valores. NUNCA versiones .env.

# Entorno: dev | prod (en prod se desactivan /docs y /openapi.json)
ENVIRONMENT=dev

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Base de datos PostgreSQL (driver psycopg v3).
# Desde docker compose el host es el servicio "profile-db"; desde el host usa "localhost".
DATABASE_URL=postgresql+psycopg://profile:profile@profile-db:5432/profile

# Validación de JWT emitidos por Authentication (este servicio solo valida).
# HS256 (desarrollo): define JWT_SECRET.
# RS256 (producción): define JWT_PUBLIC_KEY (PEM) y cambia JWT_ALGORITHM=RS256.
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-dev-only
JWT_PUBLIC_KEY=
# Opcionales: si se definen, se validan los claims iss y aud del token.
JWT_ISSUER=
JWT_AUDIENCE=
